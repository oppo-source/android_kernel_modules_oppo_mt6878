load("//build/bazel_mgk_rules:mgk_ko.bzl", "define_mgk_ko")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
    name = "public_headers",
    srcs = glob([
        "inc/*.h",
        "frame-sync/*.h",
    ]),
)

define_mgk_ko(
    name = "mtk_imgsensor",
    srcs = glob([
        "**/*.c",
        "**/*.h",
        "**/Kbuild",
        "**/Makefile",
    ]) + [
        "//vendor/mediatek/kernel_modules/mtkcam:public_headers",
        "//vendor/mediatek/kernel_modules/mtkcam/imgsensor:public_headers",
        "//vendor/mediatek/kernel_modules/mtkcam:kbuild_makefiles",
        "//vendor/mediatek/kernel_modules/mtkcam/cam_cal:public_headers",
        "//vendor/mediatek/kernel_modules/mtkcam/cam_cal:kbuild_makefiles",
        "//vendor/mediatek/kernel_modules/mtkcam/cam_cal/src_v4l2:public_headers",
        "//vendor/mediatek/kernel_modules/mtkcam/cam_cal/src_v4l2:kbuild_makefiles",
        "//vendor/oplus/kernel/camera:oplus_camera_public_headers",
    ],
    deps = [
        "//vendor/mediatek/kernel_modules/mtkcam/cam_cal/src_v4l2/custom:mtk_cam_cal",
        "//vendor/oplus/kernel/camera:oplus_camera_monitor",
    ],
    outs = [
        "imgsensor-glue/imgsensor-glue.ko",
        "imgsensor.ko",
    ],
)
