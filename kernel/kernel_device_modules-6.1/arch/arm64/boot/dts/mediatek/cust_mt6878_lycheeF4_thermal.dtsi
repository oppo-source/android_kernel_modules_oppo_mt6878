#include <dt-bindings/iio/mt635x-auxadc.h>
#include <dt-bindings/pinctrl/mt6363-pinfunc.h>

&mt6363_pio {
	mt6363_gpio2: mt6363_gpio2 {
		pins_cmd_dat {
			pinmux = <PINMUX_MT6363_GPIO2__FUNC_GPIO2>;
			bias-pull-up;
		};
	};
	mt6363_gpio7: mt6363_gpio7 {
		pins_cmd_dat {
			pinmux = <PINMUX_MT6363_GPIO7__FUNC_GPIO7>;
			bias-pull-up;
		};
	};
	mt6363_gpio1: mt6363_gpio1 {
		pins_cmd_dat {
			pinmux = <PINMUX_MT6363_GPIO1__FUNC_GPIO1>;
			bias-pull-up;
		};
	};
};

&pmic_adc {
	vin2-100k {
		channel = <AUXADC_VIN2>;
		pures = <ADC_PURES_100K>;
	};
	vin7-100k {
		channel = <AUXADC_VIN7>;
		pures = <ADC_PURES_100K>;
	};
	vin1-100k {
		channel = <AUXADC_VIN1>;
		pures = <ADC_PURES_100K>;
	};
};

