&thermal_zones {
	board_ntc: board_ntc {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&boardntc>;
        trips {
			board_ntc_crit: board_ntc-crit {
				temperature = <120000>;
				hysteresis = <2000>;
				type = "passive";
			};
        };
	};

	flashlight_ntc: flashlight_ntc {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&flashntc>;
		trips {
			flashlight_ntc_crit: flashlight_ntc-crit {
				temperature = <120000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};

};
