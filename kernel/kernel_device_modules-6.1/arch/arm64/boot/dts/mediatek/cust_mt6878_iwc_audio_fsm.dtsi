&odm {
	frsm_amp: frsm_amp {
		compatible = "foursemi,frsm-amp";
		frsm,amp-ndev = <2>;
		frsm,class-enable;
		status = "ok";
	};
};

/* i2c device */
&i2c9 {
	spk_amp1: fs18xx@34 {
		compatible = "foursemi,fs1815";
		reg = <0x34>;
		spkr-id = <2>;
		fwm-name = "frsm-spk2.bin";
		status = "okay";
	};

	spk_amp2: fs18xx@35 {
		compatible = "foursemi,fs1815";
		reg = <0x35>;
		spkr-id = <1>;
		fwm-name = "frsm-spk1.bin";
		status = "okay";
	};
};

