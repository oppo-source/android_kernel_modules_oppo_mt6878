#include <dt-bindings/iio/mt635x-auxadc.h>
#include <dt-bindings/pinctrl/mt6373-pinfunc.h>
#include <dt-bindings/pinctrl/mt65xx.h>
#include <dt-bindings/mfd/mt6375.h>
#include <dt-bindings/iio/adc/mediatek,mt6375_auxadc.h>
#include <dt-bindings/iio/adc/mediatek,mt6375_adc.h>
#include "oplus_chg.h"

&regulator_vibrator{
	min-volt = <3000000>;
	max-volt = <3000000>;
	vib-supply = <&mt6369_vibr>;
};

&mtk_gauge {
	status = "okay";
	charger = <&mt6375_chg>;
	FUELGAGUE_APPLY = <(1)>;
	IS_SUBBOARD_TEMP_SUPPORT = <(0)>;
	EXTERNAL_AUTHENTICATE =<(1)>;
	Enable_Is_Force_Full = <(1)>;

	active-table = <(5)>;
	r-fg-value = <(1)>; /* R_sense resistance. evb1 use 2; evb2 and later use 1 milliohm */
	com-r-fg-value = <(0)>; /* R_sense compensate resistance. not use COM_R_FG_VALUE */
	unit-multiple = <(2)>;
	curr-measure-20a = <(1)>;
	RBAT_PULL_DOWN_R = <(24000)>;
	RBAT_PULL_UP_R = <(12000)>;
	RBAT_PULL_UP_VOLT = <(2800)>;
	USE_MORE_PRECISE_NTC_TABLE = <(1)>;
	car-tune-value = <(100)>;
	BAT_VOLTAGE_LOW_BOUND =  <(2750)>;
	LOW_TMP_BAT_VOLTAGE_LOW_BOUND =  <(2850)>;
	SHUTDOWN_GAUGE1_VBAT = <(27500)>;
	shutdown-gauge0-voltage = <(27500)>;
	VBAT2_DET_VOLTAGE1 = <(28000)>;
	VBAT2_DET_VOLTAGE2 = <(26000)>;
	VBAT2_DET_VOLTAGE3 = <(28500)>;
	SHUTDOWN_1_TIME = <(60)>;
	DIM2_TABLE_DISTINGUISH = <(1)>;
	AGING_FACTOR_MIN = <(75)>;
	BAT_BH_EN = <(1)>;
	keep-100-percent-minsoc = <(9500)>;
	aging-factor-diff = <(1)>;
	keep-100-percent = <(2)>;
	dynamic-shutdown-cond = <0>;

	/* compensate The resistance of PCB */
	com-fg-meter-resistance = <(-20)>;
	#include "bat_setting/mt6878_battery_prop_dim2_ext_25085_25329.dtsi"
	#include "bat_setting/mt6878_battery_table_25085_25329.dtsi"
};

&mt6375_chg {
	chg-tmr = <15>;
	ircmp_v = <0>;
};

&soc {
	mt6375_gauge: mt6375_chg {
		status = "okay";
		compatible = "oplus,hal_mt6375_gauge";

		oplus,ic_type = <OPLUS_CHG_IC_GAUGE>;
		oplus,ic_index = <1>;
		oplus,batt_num = <1>;
		oplus,mtk_gauge_power_sel_support;
		oplus,mtk_gauge_cali_track_support;
		oplus,mtk_gauge_power_sel_by_power_support;

		oplus,vbatt_full_cv = <44600>;
		oplus,term_vol_temp_range = <350 200 100 0 (-100)>;
		oplus,term_vol_base = <29000 29000 29000 29000 30000 30000>;
	};
};

&u2port0 {
	mediatek,eye-vrt = <5>;
	mediatek,eye-term = <7>;
	mediatek,rev6 = <1>;
	mediatek,eye-vrt-host = <2>;
	mediatek,eye-term-host = <2>;
	mediatek,rev6-host = <1>;
	mediatek,discth = <5>;
};

&extcon_usb {
	vbus-current = <1300000>;
};

&uart0 {
	pinctrl-names = "uart0_rx_gpio", "uart0_tx_gpio";
	pinctrl-0 = <&uart0_rx_gpio_input>;
	pinctrl-1 = <&uart0_tx_gpio_input>;
	status = "okay";
	txpin = <48>;
	rxpin = <49>;
};

&pio {
	uart0_rx_gpio_input: uart0_rx_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO49__FUNC_GPIO49>; /* URXD0 */
			input-enable;
			bias-disable;
		};
	};

	uart0_tx_gpio_input: uart0_tx_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO48__FUNC_GPIO48>; /* UTXD0 */
			input-enable;
			bias-disable;
		};
	};
};

&pio {
	charging_inter_active: charging_inter_active {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO8__FUNC_GPIO8>;
			input-enable;
			bias-pull-up;
		};
	};

	charging_inter_sleep: charging_inter_sleep {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO8__FUNC_GPIO8>;
			input-enable;
			bias-pull-up;
		};
	};

	i2c10_i2c_state: i2c10_i2c_state {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO145__FUNC_SCL10>,
				 <PINMUX_GPIO146__FUNC_SDA10>;
			bias-disable;
		};
	};

	i2c10_output_low_state: i2c10_output_low_state {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO145__FUNC_GPIO145>,
				 <PINMUX_GPIO146__FUNC_GPIO146>;
			output-low;
		};
	};

	charger_pins_default: eint0default {
	};
};

&soc {
	oplus_chg_core {
		oplus,chg_framework_v2;
		oplus,smart_charging_screenoff;
		oplus,chg_spec_version = <OPLUS_CHG_SPEC_VER_V3P7_2>;
		oplus,common-charge-icl-support;

		oplus-charger {
			mtk_6895_groups: oplus,mtk_6895-groups {
