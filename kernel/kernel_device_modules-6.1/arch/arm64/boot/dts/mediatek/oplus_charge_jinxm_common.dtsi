&pio {
	i2c4_mode_default: i2c4_mode_default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO133__FUNC_SCL4>,
				 <PINMUX_GPIO134__FUNC_SDA4>;
			bias-pull-up = <MTK_PULL_SET_RSEL_111>;
		};
	};

	i2c4_output_low_state: i2c4_output_low_state {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO133__FUNC_GPIO133>,
				 <PINMUX_GPIO134__FUNC_GPIO134>;
			output-low;
		};
	};
};

&i2c4 {
	status = "okay";
	clock-frequency = <400000>;

	oplus_sc5891: oplus,sc5891@4A {
		compatible = "oplus,sc5891";
		status = "okay";
		reg = <0x4A>;
		oplus,ic_type = <OPLUS_CHG_IC_GAUGE>;
		oplus,ic_index = <0>;

		oplus,i2c_scl-gpio = <&pio 133 0x00>;
		oplus,i2c_sda-gpio = <&pio 134 0x00>;
		oplus,prikey_index = <0>;
		oplus,sc5891_fault_mitigation = <1>;
		pinctrl-names = "default", "output-low-state";
		pinctrl-0 = <&i2c4_mode_default>;
		pinctrl-1 = <&i2c4_output_low_state>;

		oplus,batt_info = /bits/ 8 <0x36 0x31 0x32 0x39 0x30 0x33 0x30 0x30 0x30 0x31 0x37 0x35
					    0x36 0x31 0x31 0x33 0x30 0x33 0x30 0x30 0x30 0x33 0x38 0x36
					    0x36 0x31 0x31 0x33 0x30 0x33 0x30 0x30 0x30 0x34 0x31 0x38
					    0x36 0x31 0x31 0x33 0x30 0x33 0x30 0x30 0x30 0x34 0x31 0x39>;
	};
};

