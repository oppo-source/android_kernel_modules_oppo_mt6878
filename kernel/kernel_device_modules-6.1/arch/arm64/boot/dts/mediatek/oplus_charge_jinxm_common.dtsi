			reverse_uisoc_range_normal_pdo_limit_list {
				temp_level_range_cold = <5000 1000>;
				temp_level_range_cool = <5000 2000>;
				temp_level_range_normal = <5000 2000>;
				temp_level_range_warm = <5000 2000>;
				temp_level_range_high = <5000 1000>;
			};

			reverse_uisoc_range_mid_high_pdo_limit_list {
				temp_level_range_cold = <5000 1000>;
				temp_level_range_cool = <5000 2000>;
				temp_level_range_normal = <5000 2000>;
				temp_level_range_warm = <5000 2000>;
				temp_level_range_high = <5000 1000>;
			};

			reverse_uisoc_range_high_pdo_limit_list {
