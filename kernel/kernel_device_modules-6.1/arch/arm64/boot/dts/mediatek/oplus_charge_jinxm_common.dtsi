		oplus_spec,volt_diff_ladder_of_keep_soc_3 = <180 190 200 0 0 0 0 0 0 0 0>;

		oplus_spec,volt_of_fast_drop_soc_1 = <2750>;

		oplus,chg_shutdown_max_mv = <2650>;

