			oplus,gauge_ic = <&oplus_sc5891 &mt6375_gauge &oplus_mt6895_gauge>;
			oplus,gauge_ic_index = <0 1 2>;
			oplus,gauge_ic_func_group = <&sc5891_gauge_groups &mt6375_gauge_groups &mt6895_gauge_groups>;
			oplus,batt_capacity_mah = <8000>;
			oplus,ic_type = <OPLUS_CHG_IC_VIRTUAL_GAUGE>;
			oplus,ic_index = <0>;
		};
	};

	oplus_chg_reverse: oplus,reverse_charge {
		compatible = "oplus,reverse_charge";
		oplus,cp_ic = <&oplus_virtual_cp>;
		oplus,reverse_ic = <&oplus_virtual_reverse_chg>;
