								4540 50 0 0 0
								4540 40 0 0 0
								4540 30 0 0 0
								4550 22 0 0 0
								4545 20 1 0 0>;
				strategy_temp_warm =		<4130 20 1 0 0>;
			};
			strategy_soc_85_to_90 {
				strategy_temp_little_cold =	<4500 20 1 0 0>;
				strategy_temp_cool =		<3980 30 0 0 0
								4180 20 1 0 0>;
				strategy_temp_little_cool =	<4080 40 0 0 0
								4230 34 0 0 0
								4230 30 0 0 0
								4420 22 0 0 0
								4430 20 1 0 0>;
				strategy_temp_little_cool_high = <4230 50 0 0 0
								4230 40 0 0 0
								4500 34 0 0 0
								4500 30 0 0 0
								4510 20 1 0 0>;
				strategy_temp_normal_low =	<4510 60 0 0 0
								4540 56 0 0 0
								4540 50 0 0 0
