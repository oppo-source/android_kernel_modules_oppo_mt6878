			0 368  589  600  600  600  600  600  600  500  0	/* OPLUS_WIRED_CHG_MODE_SDP */
			0 368  589  736  1473 1600 1600 1600 1600 1000 0	/* OPLUS_WIRED_CHG_MODE_CDP */
