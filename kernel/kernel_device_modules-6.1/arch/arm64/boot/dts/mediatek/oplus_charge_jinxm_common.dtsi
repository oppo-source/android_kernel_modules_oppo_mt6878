&soc {
	mt6375_debug: oplus_mt6375_debug {
		status = "okay";
		compatible = "oplus,hal_mt6375";

		oplus,tcpc_name = "type_c_port0";

		oplus,ic_type = <OPLUS_CHG_IC_BUCK>;
		oplus,ic_index = <1>;
	};
};

&soc {
	oplus,chg_gki {
		compatible = "oplus,chg-gki";
	};
};

&charger {
	io-channels = <&mt6369_adc (AUXADC_VIN1 | ADC_PURES_OPEN_MASK)>,
		      <&mt6369_adc (AUXADC_VIN2 | ADC_PURES_OPEN_MASK)>,
		      <&mt6369_adc (AUXADC_VIN2 | ADC_PURES_OPEN_MASK)>,
		      <&pmic_adc (AUXADC_VIN5 | ADC_PURES_100K)>,
		      <&pmic_adc (AUXADC_VIN5 | ADC_PURES_100K)>,
		      <&mt6375_adc MT6375_ADC_VBAT>;
	io-channel-names = "auxadc1-ntc_sub_bat_tem",
			   "auxadc6_usb_btb_temp",
			   "slave_cp_temp",
			   "auxadc5_batt_btb_temp",
			   "auxadc5-chargeric_temp",
			   "vbat_pwr_vol";

	pinctrl-names = "default";
	pinctrl-0 = <&charger_pins_default>;
	oplus,support_ntc_01c_precision;
	oplus,support_subboard_ntc;
	max_charger_voltage = <15000000>;
	/* ntc_resistance:100k internal_pull_up:100k voltage:1.84v */
	oplus,ntc_temp_volt_1840mv;

	oplus,usb_aicl_enhance;
	/* usbtemp dischg use pmic regulator to set vbus down */
	oplus,support_usbtemp_dischg_reg_configurable;
	oplus,usbtemp_dischg_reg_addr = <0x989>;
	oplus,usbtemp_dischg_reg_mask = <0x7>;
	oplus,usbtemp_dischg_enable = <0x2>;
	oplus,usbtemp_dischg_disable = <0x0>;
	oplus,low_batt_otg_boost_curr_ua = <500000>;
	oplus,ic_type = <OPLUS_CHG_IC_BUCK>;
	oplus,ic_index = <0>;

	oplus_mt6895_gauge: oplus,mt6895_gauge {
		oplus,ic_type = <OPLUS_CHG_IC_GAUGE>;
		oplus,ic_index = <2>;
	};

	oplus_virtual_dpdm_switch: oplus,virtual_dpdm_switch {
		oplus,ic_type = <OPLUS_CHG_IC_MISC>;
		oplus,ic_index = <0>;
	};

	oplus_mtk_pps: oplus,mtk_pps {
		oplus,ic_type = <OPLUS_CHG_IC_PPS>;
		oplus,ic_index = <0>;
	};

	oplus_mt6895_reverse_chg: oplus,mt6895_reverse_chg {
		oplus,ic_type = <OPLUS_CHG_IC_REVERSE>;
		oplus,ic_index = <2>;
	};
};

&soc {
	prechg_param:prechg_param {
		sdp_type {
			oplus,chg-type = <OPLUS_PRECHG_TYPE_SDP>;
			oplus,input-current-ma = <500>;
			oplus,temp-boundary-degc = <(-10) (-5) 0 5 12 16 21 35 45 53>;
			oplus,temp-hyst-degc = <2>;
			oplus,ichg-ma = <
				/*           <-10 <-5  <0   <5   <12  <16  <21  <35  <45  <53  >=53 */
				/* stage0 */ 0    250  250  250  250  250  250  250  250  250  0
				/* stage1 */ 0    250  250  250  250  250  250  250  250  250  0
				/* stage2 */ 0    600  600  600  600  600  600  600  600  600  0
				/* stage3 */ 0    368  589  600  600  600  600  600  600  600  0
				/* stage4 */ 0    368  589  600  600  600  600  600  600  600  0
			>;
			oplus,stage-thd-mv = <
				/*                <-10 <-5  <0   <5   <12  <16  <21  <35  <45  <53  >=53 */
				/* stage0 high */ 2500 2500 2500 2500 2500 2500 2500 2500 2500 2500 2500
				/* stage1 high */ 2750 2750 2750 2750 2750 2750 2750 2750 2750 2750 2750
				/* stage2 high */ 3880 3880 3980 3980 4080 4080 4080 4080 4080 4080 4080
				/* stage3 high */ 4180 4180 4200 4180 4230 4230 4280 4280 4280 4280 4280
			>;
			oplus,pre2fast-thd-mv = <
				/*           <-10 <-5  <0   <5   <12  <16  <21  <35  <45  <53  >=53 */
				/* stage0 */ 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200
				/* stage1 */ 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200
				/* stage2 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage3 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage4 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
			>;
		};
		cdp_type {
			oplus,chg-type = <OPLUS_PRECHG_TYPE_CDP>;
			oplus,input-current-ma = <1500>;
			oplus,temp-boundary-degc = <(-10) (-5) 0 5 12 16 21 35 45 53>;
			oplus,temp-hyst-degc = <2>;
			oplus,ichg-ma = <
				/*           <-10 <-5  <0   <5   <12  <16  <21  <35  <45  <53  >=53 */
				/* stage0 */ 0    250  250  250  250  250  250  250  250  250  0
				/* stage1 */ 0    250  250  250  250  250  250  250  250  250  0
				/* stage2 */ 0    736  736  1473 1600 1600 1600 1600 1600 1600 0
				/* stage3 */ 0    368  589  736  1600 1600 1600 1600 1600 1600 0
				/* stage4 */ 0    368  589  736  1473 1600 1600 1600 1600 1600 0
			>;
			oplus,stage-thd-mv = <
				/*                <-10 <-5  <0   <5   <12  <16  <21  <35  <45  <53  >=53 */
				/* stage0 high */ 2500 2500 2500 2500 2500 2500 2500 2500 2500 2500 2500
				/* stage1 high */ 2750 2750 2750 2750 2750 2750 2750 2750 2750 2750 2750
				/* stage2 high */ 3880 3880 3980 3980 4080 4080 4080 4080 4080 4080 4080
				/* stage3 high */ 4180 4180 4200 4180 4230 4230 4280 4280 4280 4280 4280
			>;
			oplus,pre2fast-thd-mv = <
				/*           <-10 <-5  <0   <5   <12  <16  <21  <35  <45  <53  >=53 */
				/* stage0 */ 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200
				/* stage1 */ 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200
				/* stage2 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage3 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage4 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
			>;
		};
		dcp_type {
			oplus,chg-type = <OPLUS_PRECHG_TYPE_DCP>;
			oplus,input-current-ma = <2000>;
			oplus,temp-boundary-degc = <(-10) (-5) 0 5 12 16 21 35 45 53>;
			oplus,temp-hyst-degc = <2>;
			oplus,ichg-ma = <
				/*           <-10 <-5  <0   <5   <12  <16  <21  <35  <45  <53  >=53 */
				/* stage0 */ 0    250  250  250  250  250  250  250  250  250  0
				/* stage1 */ 0    250  250  250  250  250  250  250  250  250  0
				/* stage2 */ 0    736  736  1473 2200 2200 2200 2200 2200 2200 0
				/* stage3 */ 0    368  589  736  2200 2200 2200 2200 2200 2200 0
				/* stage4 */ 0    368  589  736  1473 2200 2200 2200 2200 2200 0
			>;
			oplus,stage-thd-mv = <
				/*                <-10 <-5  <0   <5   <12  <16  <21  <35  <45  <53  >=53 */
				/* stage0 high */ 2500 2500 2500 2500 2500 2500 2500 2500 2500 2500 2500
				/* stage1 high */ 2750 2750 2750 2750 2750 2750 2750 2750 2750 2750 2750
				/* stage2 high */ 3880 3880 3980 3980 4080 4080 4080 4080 4080 4080 4080
				/* stage3 high */ 4180 4180 4200 4180 4230 4230 4280 4280 4280 4280 4280
			>;
			oplus,pre2fast-thd-mv = <
				/*           <-10 <-5  <0   <5   <12  <16  <21  <35  <45  <53  >=53 */
				/* stage0 */ 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200
				/* stage1 */ 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200
				/* stage2 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage3 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage4 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
			>;
		};
		invalid_type {
			oplus,chg-type = <OPLUS_PRECHG_TYPE_INVALID>;
			oplus,input-current-ma = <500>;
			oplus,temp-boundary-degc = <(-10) (-5) 0 5 12 16 21 35 45 53>;
			oplus,temp-hyst-degc = <2>;
			oplus,ichg-ma = <
				/*           <-10 <-5  <0   <5   <12  <16  <21  <35  <45  <53  >=53 */
				/* stage0 */ 0    250  250  250  250  250  250  250  250  250  0
				/* stage1 */ 0    250  250  250  250  250  250  250  250  250  0
				/* stage2 */ 0    600  600  600  600  600  600  600  600  600  0
				/* stage3 */ 0    368  589  600  600  600  600  600  600  600  0
				/* stage4 */ 0    368  589  600  600  600  600  600  600  600  0
			>;
			oplus,stage-thd-mv = <
				/*                <-10 <-5  <0   <5   <12  <16  <21  <35  <45  <53  >=53 */
				/* stage0 high */ 2500 2500 2500 2500 2500 2500 2500 2500 2500 2500 2500
				/* stage1 high */ 2750 2750 2750 2750 2750 2750 2750 2750 2750 2750 2750
				/* stage2 high */ 3880 3880 3980 3980 4080 4080 4080 4080 4080 4080 4080
				/* stage3 high */ 4180 4180 4200 4180 4230 4230 4280 4280 4280 4280 4280
			>;
			oplus,pre2fast-thd-mv = <
				/*           <-10 <-5  <0   <5   <12  <16  <21  <35  <45  <53  >=53 */
				/* stage0 */ 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200
				/* stage1 */ 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200
				/* stage2 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage3 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage4 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
			>;
		};
	};
};

&mt6375_chg {
	support_icl_optimization;
};

&lk_charger {
	en_vol_ctrl_vibrate = <3200>;
	read_vbat_from_cp;
	support_tuv_authentication;
	high-temp-scheme;
	support_icl_optimization;
	charger_no_wiress;
	support_battery_type = <8>;
	support_chg_time_cnt;
	support_chg_time_r;
	support_chg_track_r;
	mt6375_wireless_prj_shipmode_support;
	data-gpio = <131>;
	//cpu-id = <7>;
	//key-id = <1>;
	oplus,batt_info = /bits/ 8 <0x36 0x31 0x32 0x39 0x30 0x33 0x30 0x30 0x30 0x31 0x37 0x35
				    0x36 0x31 0x31 0x33 0x30 0x33 0x30 0x30 0x30 0x33 0x38 0x36
				    0x36 0x31 0x31 0x33 0x30 0x33 0x30 0x30 0x30 0x34 0x31 0x38
				    0x36 0x31 0x31 0x33 0x30 0x33 0x30 0x30 0x30 0x34 0x31 0x39>;
	oplus,batt_resource_info = /bits/ 8 <0 0>;
	sub_board_temp_support;
	support_sili_sc5891;
	over_high_temp_thr = <60>;
	sub_board_adc_channel = <18>;		/* AUXADC_CHAN_VIN1 in LK, Use the MT6368 PMIC */
	sub_board_adc_pmic = <1>;		/* use the MT6368 Pmic, in lk2 it's name is "second_pmic_sdmadc" */
	sub_board_adc_pull_up_voltage = <1840>;
	sub_board_adc_pures = <3>;	/* config as SDMADC_100K */

	support_sdp_screenoff;
	sdp_screenon_voltage = <3250>;
	support_quickboot_charge;
	set_plat_vsysmin = <3400>;

	/* mt6899 start */
	led-brightness = <102>;
	/* mt6899, such as max_charger_voltage to max-charger-voltage */
	max-charger-voltage = <15000000>;
	boot-battery-voltage = <3400000>;
	usb-charger-current = <500000>;
	ac-charger-current = <2050000>;
	ac-charger-input-current = <1500000>;
	non-std-ac-charger-current = <750000>;
	charging-host-charger-current = <1500000>;
	ta-ac-charger-current = <1500000>;
	pd-charger-current = <500000>;
	/* mt6899 end */

	/* sc83107 start*/
	support_boost_sc83107;
	sc83107_i2c_id = <3>;
	sc83107_irq_gpio = <12>;
	/* sc83107 end*/

	/* for silicon battery */
	is_silicon_battery;
	max-term-voltage-mv = <3260>;
	min-term-voltage-mv = <2750>;
	max-boot-thd-mv = <(3360)>;
	min-boot-thd-mv = <(2950)>;
	dcp-max-boot-thd-mv = <(3310)>;
	dcp-min-boot-thd-mv = <(2850)>;

	nochg-boot-thd-inc-mv = <(50)>;
	dcp-boot-thd-inc-mv = <(-300)>;
	cdp-boot-thd-inc-mv = <(50)>;
	sdp-boot-thd-inc-mv = <(50)>;
	wls-boot-thd-inc-mv = <(50)>;

	prechg1-thd-mv = <2900>;
	prechg1-current-ma = <250>;

	temp-low-inc1 = <500>; /* < -20 */
	temp-low-inc2 = <500>; /* -20 ~ -10 */
	temp-low-inc3 = <500>; /* -10 ~ 0 */
	temp-low-inc4 = <100>; /* 0 ~ 20 */
	temp-low-inc5 = <0>; /* > 20 */
	/* silicon battery end */
	prechg_param = <&prechg_param>;
};

&soc {
	oplus_mms_wired: oplus,mms_wired {
		compatible = "oplus,mms_wired";
		oplus,buck_ic = <&oplus_virtual_buck>;
		oplus,voocphy_ic = <&oplus_virtual_vphy>;
		oplus,adc_info_name = "100k_1840mv";
		oplus_spec,usbtemp_batttemp_gap = <12>;
		high-temp-scheme;

		/* support for V2.0 usbtemp protect. */
		oplus,support_usbtemp_protect_v2;
		oplus_spec,usbtemp_batt_temp_low = <50>;
		oplus_spec,usbtemp_batt_temp_high = <50>;
		oplus_spec,usbtemp_batt_temp_over_hot = <60>;
		oplus_spec,usbtemp_ntc_temp_low = <57>;
		oplus_spec,usbtemp_ntc_temp_high = <69>;
		oplus_spec,usbtemp_temp_gap_low_with_batt_temp = <7>;
		oplus_spec,usbtemp_temp_gap_with_batt_temp_in_over_hot = <15>;
		oplus_spec,usbtemp_temp_gap_high_with_batt_temp = <12>;
		oplus_spec,usbtemp_temp_gap_low_without_batt_temp = <12>;
		oplus_spec,usbtemp_temp_gap_high_without_batt_temp = <24>;
		oplus_spec,usbtemp_rise_fast_temp_low = <3>;
		oplus_spec,usbtemp_rise_fast_temp_high = <3>;
		oplus_spec,usbtemp_rise_fast_temp_count_low = <30>;
		oplus_spec,usbtemp_rise_fast_temp_count_high = <20>;
		oplus_spec,usbtemp_cool_down_ntc_low = <54>;
		oplus_spec,usbtemp_cool_down_ntc_high = <65>;
		oplus_spec,usbtemp_cool_down_gap_low = <12>;
		oplus_spec,usbtemp_cool_down_gap_high = <20>;
		oplus_spec,usbtemp_cool_down_recover_ntc_low = <48>;
		oplus_spec,usbtemp_cool_down_recover_ntc_high = <60>;
		oplus_spec,usbtemp_cool_down_recover_gap_low = <6>;
		oplus_spec,usbtemp_cool_down_recover_gap_high = <15>;
		oplus_spec,lpd_support_status = <2>;
		oplus_spec,lpd_sbu_thr_mv = <320 480>;
		oplus_spec,lpd_sbu_pullup_thr_mv = <1600 2400>;

		oplus_virtual_buck: oplus,virtual_buck {
			compatible = "oplus,virtual_buck";
			oplus,buck_ic = <&charger &mt6375_debug &byb_hl7603>;
			oplus,buck_ic_index = <0 1 2>;
			oplus,buck_ic_current_ratio = <100 0 0>;
			oplus,buck_ic_connect = <OPLUS_CHG_IC_CONNECT_PARALLEL>;
			oplus,main_charger = <0>;
			oplus,buck_ic_func_group = <&mtk_6895_groups &mt6375_debug_groups &byb_hl7603_groups>;

			oplus,ic_type = <OPLUS_CHG_IC_VIRTUAL_BUCK>;
			oplus,ic_index = <0>;

			io-channels = <&pmic_adc (AUXADC_VIN3 | ADC_PURES_100K)>,
				      <&pmic_adc (AUXADC_VIN4 | ADC_PURES_100K)>;
			io-channel-names = "usb_temp_adc_l", "usb_temp_adc_r";

			oplus,uart_tx-gpio = <&pio 48 0x00>;
			oplus,uart_rx-gpio = <&pio 49 0x00>;
		};
	};

	oplus_mms_gauge: oplus,mms_gauge {
		compatible = "oplus,mms_gauge";
		oplus,gauge_ic = <&oplus_virtual_gauge>;
		oplus,voocphy_ic = <&oplus_virtual_vphy>;
		oplus,topic-update-interval = <10000>;
		oplus,support_subboard_ntc;
		oplus,fcl_support;
		oplus,fcl_index = <1>;
		oplus,vb_offset = <0>;

		deep_spec,support;
		deep_spec,soc_boost_term_voltage_offset_mv = <0>;
		deep_spec,uv_thr = <2750>;
		deep_spec,count_thr = <50>;
		deep_spec,vbat_soc = <80>;
		deep_spec,count_step = <0   10 0
					350 12 1
					450 15 2
					530 20 3>;

		deep_spec,term_coeff = <2900 600  0
					2910 600  0
					2950 600  0
					3000 650  0
					3010 650  0
					3050 700  0
					3100 800  0
					3110 800  0
					3150 850  0
					3160 850  0
					3200 950  0
					3210 950  0
					3260 1050 0>;
		deep_spec,ddrc_strategy_name = "ddrc_curve_v2";
		oplus,ddrc_temp_switch = <4>;
		deep_spec,volt_step = <20>;
		deep_spec,ddbc_curve {
			oplus,temp_type = <OPLUS_STRATEGY_USE_BATT_TEMP>;
			oplus,temp_range = <(-100) 0 200>;
			deep_spec,ddbc_temp_cold = <500 3050 5
						   10000 3000 2>;
			deep_spec,ddbc_temp_cool = <500 3050 5
						   10000 3000 2>;
			deep_spec,ddbc_temp_normal = <500 3050 5
						   10000 3000 2>;
			deep_spec,ddbc_temp_warm = <500 3050 5
