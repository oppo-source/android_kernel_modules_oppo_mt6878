//ifdef OPLUS_FEATURE_CHG_BASIC
&oplus_cpa {
	oplus,cpa_region_cfg_pps {
		oplus,region_id = /bits/ 8 <0x00 0x44 0x83 0x5a>; /* t0 machine: 0x00, europe: 0x44 Saudi Arabia: 0x83  Serbia: 0x5a*/
		oplus,protocol_list = <CHG_PROTOCOL_VOOC 45
					CHG_PROTOCOL_PPS  45
					CHG_PROTOCOL_PD   15>;
		oplus,default_protocol_list = <CHG_PROTOCOL_VOOC
					CHG_PROTOCOL_PPS
					CHG_PROTOCOL_PD>;
	};
};

&charger {
	oplus_ap_pps: oplus,ap_pps {
		oplus,ic_type = <OPLUS_CHG_IC_PPS>;
		oplus,ic_index = <0>;
	};
};

