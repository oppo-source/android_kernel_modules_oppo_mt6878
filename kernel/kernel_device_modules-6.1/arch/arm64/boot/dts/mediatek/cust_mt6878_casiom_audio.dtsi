&pio {
	sia81xx_gpio_R: sia81xx_gpio_R {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO149__FUNC_GPIO149>;
			slew-rate = <1>;
			bias-disable;
		};
	};
};

&odm {
	si_pa_R: si_pa_R {
		compatible = "si,sia81xx";
		si,si_pa_type = "sia81x9";
		si,si_pa_reset = <&pio 149 0>;
		pinctrl-names = "si_pa_gpio";
		pinctrl-0 = <&sia81xx_gpio_R>;
		en_compatible_type_func = <1>;
		si,si_pa_disable_pin = <0>;
		en_dynamic_id = <0>;
		en_irq_func = <0>;
		channel_num = <1>;
	};
};

&sound {
	si,sia81xx-max-num = <1>;
	si,sia81xx-aux-devs = <&si_pa_R>;
	si,sia81xx-aux-devs-prefix = "SpkrRight";
	si,is_analog_pa = <1>;
};

&i2c9 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;

	aw87xxx_pa@58 {
		compatible = "awinic,aw87xxx_pa_2_x_0";
		reg = <0x58>;
		reset-gpio = <&pio 149 0>;
		dev_index = < 1 >;
		status = "okay";
	};

	sipa_i2c_R: sipa_i2c_R@28{
		compatible = "si,sia81xx-i2c";
		#sound-dai-cells = <0>;
		reg = <0x28>;
		si,sipa-dev = <&si_pa_R>;
		status = "okay";
	};

	fsa4480: fsa4480@42 {
		compatible = "qcom,fsa4480-i2c";
		reg = <0x42>;
		fsa4480,hp-bypass = <1>;
		status = "okay";
	};
};

&accdet {
	headset-three-key-threshold = <0 80 220 400>;
	headset-eint0-disable = <1>;
	typec_switch_type = <2>;
};
