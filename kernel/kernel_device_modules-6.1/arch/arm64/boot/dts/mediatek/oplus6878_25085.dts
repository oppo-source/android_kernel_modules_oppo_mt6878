&odm {
/* Add for sim detect */
    oplus_sim_detect {
        compatible = "oplus, sim_detect";
        Hw,sim_det = <&pio 46 0x00>;
    };
};

/* Alpha-H does not use SD card, vmch is used by panel VCI */
&mmc1 {
	host-index = <1>;
	status = "disabled";
};

/*mt6369-vmch*/
&spmi {
	second_pmic@5 {
		regulators {
			mt6369_vmch: vmch {
				regulator-compatible = "VMCH";
				regulator-name = "mt6369_vmch";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3500000>;
				regulator-enable-ramp-delay = <680>;
				regulator-allowed-modes = <0 2>;
				regulator-always-on;
			};
			mt6369_vio28: vio28 {
				regulator-compatible = "VIO28";
				regulator-name = "mt6369_vio28";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3500000>;
				regulator-enable-ramp-delay = <680>;
				regulator-allowed-modes = <0 2>;
			};
			mt6369_vmc: vmc {
				regulator-compatible = "VMC";
				regulator-name = "mt6369_vmc";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3500000>;
				regulator-enable-ramp-delay = <680>;
				regulator-allowed-modes = <0 2>;
			};
		};
	};
};

&dsi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	panel26@25 {
		compatible = "aa682,p,3,a0004,cmd";
		reg = <0>;
		vddr-enable-gpios = <&pio 3 0>;
		vddi-supply = <&mt6369_vmc>;
		vci-supply = <&mt6369_vio28>;
		reset-gpios = <&pio 90 0>;
		oplus,panel-max-brightness=<4094>;
		oplus,dsi-serial-number-enabled= <1>;
		oplus,dsi-serial-number-switch-page;
		oplus,dsi-serial-number-index= <0>;
		oplus,dsi-serial-number-switch-page-command= <0xFF 0x08 0x38 0x1D>;
		oplus,dsi-serial-number-default-switch-page-command= <0xFF 0x08 0x38 0x00>;
		oplus,dsi-serial-number-reg= <0x81>;
		oplus,dsi-serial-number-read-count= <7>;
		res-switch = <2>;
		/* OFP config */
		oplus,ofp-fp-type = <0x10>;
		oplus,ofp-fp-local-hbm-calibration;
		oplus,ofp-longrui-aod-config = <0x02>;
		/* fp red lhbm or hbm reg*/
		oplus,ofp-read-hbm-reg = <0x95>;
		oplus,ofp-check-hbm-reg-value = <0x13>;
		oplus,ofp-check-hbm-reg-mask = <0xFF>;
		pinctrl-names = "default";
		port {
			panel_in22: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};

	ports {
		port {
			dsi_out: endpoint {
				remote-endpoint = <&panel_in22>;
			};
		};
	};
};

&odm {
    /*OPLUS_FEATURE_OEM_OCDT oppo project start */
	oplus_project:oplus_project {
		compatible = "oplus,oplus_project";
	};
    
    oplus_boardid:oplus_boardid {
		compatible = "oplus,oplus_boardid-v2";
		support-dtsino=<25085>;//only one u32
		/*first one is low 32bit, last one is highest 32bit, must be 32-bit for 4gpios*/
		support-pcbmask=<0xffffffff 0xffffffff 0xffffffff>;
	};

	pmic_history_count:pmic_history_count {
	};
	pmic_history0:pmic_history0 {
	};
	pmic_history1:pmic_history1 {
	};
	pmic_history2:pmic_history2 {
	};
	pmic_history3:pmic_history3 {
	};

};

//Network RF add SWTP
&pio {
	//#ifdef OPLUS_VENDOR_SWTP
	swtp: swtp {
		compatible = "mediatek, swtp-eint";
	};
	 swtp_1: swtp_1 {
		compatible = "mediatek, swtp1-eint";
	};
	//#endif  /*OPLUS_VENDOR_SWTP*/
};

/*
 * Trustonic Mobilecore real driver
 */
&mobicore{
        trustonic,real-drv = <1>;
};

//#ifdef OPLUS_FEATURE_STORAGE
&mmc1_pins_default {
	pins-clk {
		drive-strength = <4>;
	};
};
&mmc1_pins_uhs {
	pins-clk {
		drive-strength = <4>;
	};
};
//#endif /*OPLUS_FEATURE_STORAGE*/

&soc {
	//@Kernel.Storage, 2024/10/16, add for blk-mq.c kblockd_ux_unbound_enable
	oplus,blk-mq {
		kblockd_ux_unbound_enable = "y";
	};
	oplus_sync_ipc {
        disable = <0xfffffeff>;
    };
	//@Kernel.Storage, 2025/06/12, add for ufs-mediatek.c ufs-vcc-always-on
	ufshci: ufshci@112b0000 {
		mediatek,ufs-vcc-always-on;
	};
	//#ifdef CONFIG_OPLUS_BINDER_STRATEGY
	oplus_binder_sched {
		thread_full_boost_task = <1>;
	};
	//#endif
};

&odm {
	oplus_mm_config: oplus,mm_config {
		compatible = "oplus,mm_osvelte-config";
		ram-8g {
			kcompressed {
				feature-enable;
			};
			ezreclaimd {
				feature-enable;
			};
			oplus_bsp_frr {
				feature-enable;
			};
		};
		ram-12g {
			ezreclaimd {
				feature-enable;
			};
			oplus_bsp_frr {
				feature-enable;
			};
		};
	};
};

