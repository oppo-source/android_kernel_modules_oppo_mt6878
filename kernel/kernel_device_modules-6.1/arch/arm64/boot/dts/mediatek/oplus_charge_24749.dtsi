		oplus_spec,wls-vbatdet-mv = <0 4210 4310 4410 4410 4410 4385 4030 0>;
		oplus_spec,fcc-gear-thr-mv = <4180>;
		oplus_spec,fcc-gear-shake-mv = <550 550 350 200 200 150 150 100 100>;
