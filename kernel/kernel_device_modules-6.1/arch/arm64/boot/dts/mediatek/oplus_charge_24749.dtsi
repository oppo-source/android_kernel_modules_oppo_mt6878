			0 600  600  600  600  600  600  600  0	/* OPLUS_WIRED_CHG_MODE_SDP */
			0 602 1600 1600 1600 1600 1600 1600 0	/* OPLUS_WIRED_CHG_MODE_CDP */
			0 602 2200 2200 2200 2200 2200 2200 0	/* OPLUS_WIRED_CHG_MODE_DCP */
			0 602 3014 3300 3300 3300 3300 3300 0	/* OPLUS_WIRED_CHG_MODE_VOOC */
			0 602 2860 2860 2860 2860 2860 2860 0	/* OPLUS_WIRED_CHG_MODE_QC */
			0 602 2860 2860 2860 2860 2860 2860 0	/* OPLUS_WIRED_CHG_MODE_PD */
		>;
		oplus_spec,fccmax-ma-hv = <
			0 484  968 2200 2200 2200 2200 2200 0	/* OPLUS_WIRED_CHG_MODE_UNKNOWN */
			0 600  600  600  600  600  600  600 0	/* OPLUS_WIRED_CHG_MODE_SDP */
			0 602  1206 1600 1600 1600 1600 600 0	/* OPLUS_WIRED_CHG_MODE_CDP */
			0 602  1206 1808 2200 2200 2200 1000 0	/* OPLUS_WIRED_CHG_MODE_DCP */
			0 602  1206 1808 3014 3300 3300 1000 0	/* OPLUS_WIRED_CHG_MODE_VOOC */
			0 602  1206 1808 2860 2860 2860 1000 0	/* OPLUS_WIRED_CHG_MODE_QC */
			0 602  1206 1808 2860 2860 2860 1000 0	/* OPLUS_WIRED_CHG_MODE_PD */
		>;
