&pio {
    nfcid_default: nfcid_default {
        pins_cmd_dat  {
            pinmux = <PINMUX_GPIO193__FUNC_GPIO193>;
            input-enable;
            bias-disable;
        };
    };

    nfcid_pullup: nfcid_pullup {
        pins_cmd_dat  {
            pinmux = <PINMUX_GPIO193__FUNC_GPIO193>;
            input-enable;
            bias-pull-up=<MTK_PUPD_SET_R1R0_10>;
        };
    };

    nfcid_pulldown: nfcid_pulldown {
        pins_cmd_dat  {
            pinmux = <PINMUX_GPIO193__FUNC_GPIO193>;
            input-enable;
            bias-pull-down=<MTK_PUPD_SET_R1R0_10>;
        };
    };
};

&odm {
    nfc_chipset:nfc_chipset {
        compatible = "oplus-nfc-chipset";
        mixed-chipset = <1>;
        id-gpio = <&pio 193 0x00>;
        id_count = <3>;
        id-0-key = <0>;
        id-0-value-chipset = "none";
        id-0-value-manifest-path = "/odm/etc/vintf/manifest_empty.xml";
        id-0-value-feature-path = "/odm/etc/feature_empty.xml";
        id-1-key = <1>;
        id-1-value-chipset = "THN31";
        id-1-value-manifest-path = "/odm/etc/vintf/manifest_nfc_thn31.xml";
        id-1-value-feature-path = "/odm/etc/com.oplus.nfc_feature_thn31.xml";
        id-2-key = <2>;
        id-2-value-chipset = "SN220E";
        id-2-value-manifest-path = "/odm/etc/vintf/manifest_nfc_sn220.xml";
        id-2-value-feature-path = "/odm/etc/com.oplus.nfc_feature_sn220.xml";
        pinctrl-names = "nfcid_default", "nfcid_pullup", "nfcid_pulldown";
        pinctrl-0 = <&nfcid_default>;
        pinctrl-1 = <&nfcid_pullup>;
        pinctrl-2 = <&nfcid_pulldown>;
    };
};

&i2c3 {
    status = "okay";
    clock-frequency = <400000>;
    tms_thn31@28 {
        compatible = "tms,nfc";
        mixed-chipset = <1>;
        id-gpio = <&pio 193 0x00>;
        id_count = <3>;
        id-0-key = <0>;
        id-0-value-chipset = "none";
        id-1-key = <1>;
        id-1-value-chipset = "THN31";
        id-2-key = <2>;
        id-2-value-chipset = "SN220E";

        reg = <0x28>;
        tms,irq-gpio = <&pio 2 0x0>;
        tms,ven-gpio = <&pio 40 0x0>;
        //tms,download-gpio = <&pio 29 0x0>;
        interrupt-parent = <&pio>;
    };
};

&i2c3 {
    status = "okay";
    clock-frequency = <400000>;
    nq@29 {
        compatible = "nxp,sn-nci";
        mixed-chipset = <1>;
        id-gpio = <&pio 193 0x00>;
        id_count = <3>;
        id-0-key = <0>;
        id-0-value-chipset = "none";
        id-1-key = <1>;
        id-1-value-chipset = "THN31";
        id-2-key = <2>;
        id-2-value-chipset = "SN220E";

        reg = <0x29>;
        nxp,sn-irq = <&pio 2 0x0>;
        nxp,sn-ven-rstn = <&pio 40 0x0>;
        nxp,sn-clkreq = <&pio 151 0x0>;
        interrupt-parent = <&pio>;
    };
};

