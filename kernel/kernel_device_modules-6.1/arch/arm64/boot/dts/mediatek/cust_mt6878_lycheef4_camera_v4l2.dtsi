	status = "okay";
	clock-frequency = <1000000>;

	camera_af_tele@0c {
		compatible = "oplus,ak7316_25331_tele";
		vin-supply = <&camera_tele_afvdd>;
		vdd-supply = <&camera_tele_afvdd>;
		reg = <0x0c>;
		port {
