&i2c9 {
	status = "okay";
	clock-frequency = <400000>;
	oplus_nu2118a_slave: nu2118a-charger-slave@6E{
		status = "okay";
		compatible = "oplus,nu2118a";
		reg = <0x6E>;
		ocp_reg = <0x2E>;
		ovp_reg = <0x70>;
		oplus,use_slave_cp;
		oplus_nu2118a_slave_cp: oplus,nu2118a_slave_cp {
			oplus,ic_type = <OPLUS_CHG_IC_CP>;
			oplus,ic_index = <1>;
			oplus,ic_func_group = <&nu2118a_cp_groups>;
		};
	};
};

