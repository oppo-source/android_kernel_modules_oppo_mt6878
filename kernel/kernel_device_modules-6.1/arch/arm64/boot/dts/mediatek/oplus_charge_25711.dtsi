					9000 2000
					9000 2500
					9000 3000>;

		oplus,normal_reverse_hw_ocp = <
					500  800
					1000 1300
					1500 1800
					2000 2300>;

		oplus,reverse_hardreset_limit = <
					5000 2000 /* 5v2a */
					9000 1500
					9000 2000
					9000 2500
					9000 3000>;

		oplus_spec,reverse-led-on-limit = <9000 1000>;

		oplus_spec,reverse-authenticate-limit = <5000 1000>;
		oplus_spec,reverse-over-ibus-limit = <5000 1000>;

		oplus,reverse_uisoc_pdo_limit_list {
			reverse_uisoc_range_min_pdo_limit_list {
				temp_level_range_cold = <5000 1500 5000 1500>;
				temp_level_range_cool = <5000 1500 5000 1500>;
				temp_level_range_normal = <5000 1500 5000 1500>;
				temp_level_range_warm = <5000 1500 5000 1500>;
				temp_level_range_high = <5000 1500 5000 1500>;
			};

			reverse_uisoc_range_mid_pdo_limit_list {
				temp_level_range_cold = <5000 1500 5000 1500>;
				temp_level_range_cool = <5000 1500 5000 1500>;
				temp_level_range_normal = <5000 1500 9000 1000>;
				temp_level_range_warm = <5000 1500 9000 1000>;
				temp_level_range_high = <5000 1500 5000 1500>;
			};

			reverse_uisoc_range_normal_pdo_limit_list {
				temp_level_range_cold = <5000 1500 5000 1500>;
				temp_level_range_cool = <5000 1500 9000 1000>;
				temp_level_range_normal = <5000 1500 9000 1500>;
				temp_level_range_warm = <5000 1500 9000 1000>;
				temp_level_range_high = <5000 1500 5000 1500>;
			};

			reverse_uisoc_range_mid_high_pdo_limit_list {
				temp_level_range_cold = <5000 1500 5000 1500>;
				temp_level_range_cool = <9000 1500 9000 1500>;
				temp_level_range_normal = <9000 2000 9000 2000>;
				temp_level_range_warm = <9000 1000 9000 1000>;
				temp_level_range_high = <5000 1500 5000 1500>;
